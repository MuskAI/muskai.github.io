<div class="research-playground">
  <section class="playground-section playground-challenge" aria-labelledby="full-challenge-title" data-challenge-carousel>
    <div class="playground-section__heading">
      <div>
        <h2 id="full-challenge-title"><i class="ti ti-scan-eye" aria-hidden="true"></i> spot the synthetic image</h2>
        <p>Choose the AI-generated image. The explanation focuses on evidence, not just intuition.</p>
      </div>
      <button class="research-button" type="button" data-challenge-next>
        New round
        <i class="ti ti-refresh" aria-hidden="true"></i>
      </button>
    </div>

    {% for round in site.data.research_widgets.challenge_rounds %}
      <div
        class="playground-challenge__round{% unless forloop.first %} is-hidden{% endunless %}"
        data-challenge-round
        data-daily-challenge
        data-clue="{{ round.clue | escape }}"
      >
        <p class="playground-challenge__prompt">{{ round.prompt }}</p>
        <div class="playground-challenge__images">
          {% for image in round.images %}
            <button
              class="challenge-image"
              type="button"
              data-challenge-choice
              data-is-ai="{{ image.ai }}"
              aria-label="Choose image {{ forloop.index }} as AI-generated"
            >
              <img src="{{ image.src | relative_url }}" alt="{{ image.alt }}" loading="lazy">
              <span aria-hidden="true">{{ forloop.index }}</span>
            </button>
          {% endfor %}
        </div>
        <div class="challenge-feedback" data-challenge-feedback role="status" aria-live="polite">Select one image to reveal the answer.</div>
      </div>
    {% endfor %}

    <details class="playground-credits">
      <summary>Image sources</summary>
      <ul>
        <li>
          Real cat photograph:
          <a
            href="https://commons.wikimedia.org/wiki/File:Cat_August_2010-4.jpg"
            target="_blank"
            rel="external nofollow noopener"
            >Alvesgaspar, CC BY-SA 3.0</a
          >
        </li>
        <li>
          Real dog photograph:
          <a href="https://commons.wikimedia.org/wiki/File:Golde33443.jpg" target="_blank" rel="external nofollow noopener"
            >Golden Trvs Gol twister, CC BY-SA 3.0</a
          >
        </li>
        <li>The cream cat and mountain bus images were generated specifically for this educational game.</li>
      </ul>
    </details>
  </section>

  <section class="playground-section" aria-labelledby="constellation-title">
    <div class="playground-section__heading">
      <div>
        <h2 id="constellation-title"><i class="ti ti-atom" aria-hidden="true"></i> research constellation</h2>
        <p>Hover to trace a connection. Select a paper or project node to open it.</p>
      </div>
    </div>
    <div
      id="research-constellation"
      class="research-constellation"
      role="region"
      aria-label="Interactive network connecting Haoran Chen's research topics, papers, and projects"
    >
      <p class="research-constellation__fallback">
        The interactive map connects <a href="{{ '/publications/' | relative_url }}">papers</a> with
        <a href="{{ '/projects/' | relative_url }}">projects</a>.
      </p>
    </div>
  </section>

  <section class="playground-section ask-research" aria-labelledby="ask-research-title" data-ask-research>
    <div class="playground-section__heading">
      <div>
        <h2 id="ask-research-title"><i class="ti ti-messages" aria-hidden="true"></i> ask my research</h2>
        <p>Start with one of these questions. Every answer points back to a paper or project.</p>
      </div>
    </div>
    <div class="ask-research__layout">
      <div class="ask-research__questions" role="list" aria-label="Research questions">
        {% for question in site.data.research_widgets.questions %}
          <button
            class="ask-research__question{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-question-target="answer-{{ question.id }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {{ question.label }}
          </button>
        {% endfor %}
      </div>
      <div class="ask-research__answers" aria-live="polite">
        {% for question in site.data.research_widgets.questions %}
          <article
            id="answer-{{ question.id }}"
            class="ask-research__answer{% unless forloop.first %} is-hidden{% endunless %}"
            data-research-answer
          >
            <h3>{{ question.label }}</h3>
            <p>{{ question.answer }}</p>
            <a href="{{ question.link | relative_url }}">
              {{- question.link_label }}
              <i class="ti ti-arrow-right" aria-hidden="true"></i
            ></a>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="playground-section feature-model" aria-labelledby="feature-model-title" data-feature-model>
    <div class="playground-section__heading">
      <div>
        <h2 id="feature-model-title"><i class="ti ti-cube-3d-sphere" aria-hidden="true"></i> explore visual layers in 3D</h2>
        <p>Drag the model to rotate it, then select a layer to inspect the kind of visual evidence it may preserve.</p>
      </div>
    </div>
    <div class="feature-model__layout">
      <div class="feature-model__viewport" data-model-viewport tabindex="0" aria-label="Draggable 3D visual layer model">
        <div class="feature-model__scene" data-model-scene>
          {% for index in (1..6) %}
            <div class="feature-model__layer" data-model-layer="{{ index }}" style="--layer-index: {{ index }}">
              <span>V{{ index }}</span>
            </div>
          {% endfor %}
          <div class="feature-model__connector">connector</div>
          <div class="feature-model__llm">LLM</div>
        </div>
      </div>
      <div class="feature-model__controls">
        <label for="feature-layer-range">Selected visual layer</label>
        <input id="feature-layer-range" data-layer-range type="range" min="1" max="6" value="3" step="1">
        <div class="feature-model__labels" aria-hidden="true"><span>shallow</span><span>deep</span></div>
        <div class="feature-model__explanation" data-layer-explanation aria-live="polite">
          Layer 3 balances local visual detail with emerging semantic structure.
        </div>
      </div>
    </div>
  </section>

  <section class="playground-section github-garden" aria-labelledby="github-garden-title">
    <div class="playground-section__heading github-garden__heading">
      <div>
        <h2 id="github-garden-title"><i class="ti ti-brand-github" aria-hidden="true"></i> contribution garden</h2>
        <p>{{ site.data.github_activity.total }} contributions in the snapshot year. Each square is one day.</p>
      </div>
      <a href="https://github.com/{{ site.data.github_activity.username }}" target="_blank" rel="external nofollow noopener">
        View GitHub <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
      </a>
    </div>
    <div class="github-garden__scroll">
      <div
        class="github-garden__grid"
        role="img"
        aria-label="GitHub contribution activity snapshot updated {{ site.data.github_activity.updated }}"
      >
        {% for week in site.data.github_activity.weeks %}
          <span class="github-garden__week" aria-hidden="true">
            {% for count in week %}
              {% assign level = 0 %}
              {% if count > 0 and count < 5 %}
                {% assign level = 1 %}
              {% elsif count >= 5 and count < 12 %}
                {% assign level = 2 %}
              {% elsif count >= 12 and count < 25 %}
                {% assign level = 3 %}
              {% elsif count >= 25 %}
                {% assign level = 4 %}
              {% endif %}
              <span
                class="github-garden__day github-garden__day--{{ level }}"
                title="{{ count }} contribution{% unless count == 1 %}s{% endunless %}"
              ></span>
            {% endfor %}
          </span>
        {% endfor %}
      </div>
    </div>
    <p class="github-garden__updated">Snapshot updated {{ site.data.github_activity.updated }}.</p>
  </section>

  <section class="playground-section focus-soundtrack" aria-labelledby="focus-soundtrack-title">
    <div class="playground-section__heading">
      <div>
        <h2 id="focus-soundtrack-title"><i class="ti ti-headphones" aria-hidden="true"></i> focus soundtrack</h2>
        <p>A public Spotify focus playlist, not a record of private listening activity.</p>
      </div>
    </div>
    <iframe
      src="{{ site.community.spotify_embed_url }}"
      title="Spotify focus playlist"
      width="100%"
      height="152"
      frameborder="0"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
    ></iframe>
  </section>

  {% include guestbook.liquid %}
</div>
