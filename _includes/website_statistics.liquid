<section
  class="website-statistics"
  data-website-statistics
  data-website-id="{{ site.umami.website_id | escape }}"
  data-share-slug="{{ site.umami.public_share.slug | escape }}"
  data-api-url="{{ site.umami.public_share.api_url | escape }}"
  aria-label="Website activity for the last 30 days"
  aria-busy="true"
>
  <header class="website-statistics__header">
    <div class="website-statistics__status" role="status" aria-live="polite">
      <span class="website-statistics__status-dot" aria-hidden="true"></span>
      <strong><i class="ti ti-activity" aria-hidden="true"></i> Live site activity</strong>
      <span class="website-statistics__status-separator" aria-hidden="true">/</span>
      <span data-statistics-status>Loading</span>
    </div>
    <a href="{{ site.umami.public_share.url }}" target="_blank" rel="noopener noreferrer">
      View analytics
      <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
    </a>
  </header>

  <div class="website-statistics__body">
    <dl class="website-statistics__metrics">
      <div class="website-statistics__metric">
        <dt>Page views</dt>
        <dd data-statistic="pageviews">--</dd>
      </div>
      <div class="website-statistics__metric">
        <dt>Visitors</dt>
        <dd data-statistic="visitors">--</dd>
      </div>
      <div class="website-statistics__metric">
        <dt>Visits</dt>
        <dd data-statistic="visits">--</dd>
      </div>
      <div class="website-statistics__metric">
        <dt>Bounce rate</dt>
        <dd data-statistic="bounce-rate">--</dd>
      </div>
    </dl>

    <div class="website-statistics__trend">
      <div class="website-statistics__trend-meta">
        <span>30-day page views</span>
        <span data-statistics-peak>Peak --</span>
      </div>
      <div class="website-statistics__chart" data-statistics-chart>
        <div class="website-statistics__chart-skeleton" aria-hidden="true"></div>
      </div>
      <p class="sr-only" data-statistics-summary></p>
      <div class="website-statistics__chart-dates" aria-hidden="true">
        <span data-statistics-start-date>--</span>
        <span data-statistics-end-date>--</span>
      </div>
    </div>
  </div>
</section>
